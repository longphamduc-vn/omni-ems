### 12. Optimization: Cờ tối ưu định mức Target Stock (GetOptimizeInfo.lgdn - t1.txt Trace 16)
POST {{baseUrl}}/emsspareparts/sp302/sp330Nav/GetOptimizeInfo.lgdn
Content-Type: {{contentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
	<Parameters>
		<Parameter id="_ems_userId">{{userId}}</Parameter>
		<Parameter id="_ems_organizationId">{{orgId}}</Parameter>
		<Parameter id="_ems_language">{{lang}}</Parameter>
	</Parameters>
	<Dataset id="ds_search">
		<ColumnInfo>
			<Column id="organizationId" type="STRING" size="256" />
			<Column id="userId" type="STRING" size="256" />
			<Column id="accelerationFlag" type="STRING" size="256" />
		</ColumnInfo>
		<Rows>
			<Row>
				<Col id="organizationId">{{orgId}}</Col>
				<Col id="userId">{{userId}}</Col>
				<Col id="accelerationFlag">Y</Col>
			</Row>
		</Rows>
	</Dataset>
</Root>


# ==============================================================================
# NHÓM 3: WORKFLOW ENGINE & DATA FUSION LAYER REST APIS (PORT 8000)
# ==============================================================================

### 13. Workflow Engine: Health Check & Token Cache Status
GET {{engineUrl}}/api/v1/health
Accept: application/json


### 14. Workflow Engine: List Available Registered Workflows
GET {{engineUrl}}/api/v1/workflows
Accept: application/json


### 15. Workflow Engine: Execute Target Stock Optimization Workflow (t1.txt flow)
POST {{engineUrl}}/api/v1/workflows/execute
Content-Type: application/json

{
  "workflow_id": "wf_target_stock_optimization",
  "inputs": {
    "organizationId": "28753",
    "userId": "658359",
    "items": [
      { "item": "QCAB17587", "inventoryItemId": "3042180" },
      { "item": "QDAE01694", "inventoryItemId": "3365330" }
    ]
  }
}


### 16. Workflow Engine: Execute Search & Enrich Items Workflow
POST {{engineUrl}}/api/v1/workflows/execute
Content-Type: application/json

{
  "workflow_id": "wf_search_and_enrich",
  "inputs": {
    "keyword": "QCAB17587",
    "status_filter": "ACTIVE",
    "items": [
      { "code": "QCAB17587" },
      { "code": "QDAE01694" }
    ]
  }
}

