		<Parameter id="organizationId">{{orgId}}</Parameter>
		<Parameter id="responsibilityIdList">69966,69968,69972</Parameter>
		<Parameter id="defaultLangUi">{{lang}}</Parameter>
		<Parameter id="_ems_userId">{{userId}}</Parameter>
		<Parameter id="_ems_organizationId">{{orgId}}</Parameter>
		<Parameter id="_ems_language">{{lang}}</Parameter>
	</Parameters>
</Root>


