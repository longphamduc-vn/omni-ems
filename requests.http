		<Parameter id="_ems_userId">{{userId}}</Parameter>
		<Parameter id="_ems_organizationId">{{orgId}}</Parameter>
		<Parameter id="_ems_language">{{lang}}</Parameter>
	</Parameters>
	<Dataset id="ds_Search">
		<ColumnInfo>
			<Column id="item" type="STRING" size="256" />
		</ColumnInfo>
		<Rows>
			<Row>
				<Col id="item">{{sampleItem}}</Col>
			</Row>
		</Rows>
	</Dataset>
</Root>


### 7. Common Codes: Từ điển danh mục mã dùng chung
# Endpoint: retComCodeList.lgdn
# Lấy danh mục mã Dropdown (statementName có thể phân cách bởi dấu hai chấm ':')
POST {{baseUrl}}/emscom/codeNav/retComCodeList.lgdn
Content-Type: {{contentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
	<Parameters>
		<Parameter id="statementName">retrieveItemType:retrieveEstimateStatus:</Parameter>
		<Parameter id="_ems_userId">{{userId}}</Parameter>
		<Parameter id="_ems_organizationId">{{orgId}}</Parameter>
		<Parameter id="_ems_language">{{lang}}</Parameter>
	</Parameters>
</Root>


### 8. Work Order: Danh sách nhà máy sản xuất (Factory / Plant List)
