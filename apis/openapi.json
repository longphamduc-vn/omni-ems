        "requestBody": {
          "content": {
            "text/xml": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nexacro Dataset: ds_result (38 cột)"
          }
        }
      }
    },
