### 9. System: Đăng nhập hệ thống (Login EMS)
# Endpoint: login.lgdn
# Lấy thông tin tài khoản người dùng, quyền trách nhiệm (ds_UserInfo, ds_Responsibility, ds_MenuList)
POST {{baseUrl}}/emscom/loginNav/login.lgdn
Content-Type: {{contentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
	<Parameters>
		<Parameter id="letsId">8CD4D1D900D8C9C7F4D64A9F586BDD1D</Parameter>
		<Parameter id="userId" />
		<Parameter id="employeeNumber" />
		<Parameter id="organizationId" />
		<Parameter id="responsibilityId" />
		<Parameter id="defaultLangMsg" />
		<Parameter id="defaultLangUi" />
		<Parameter id="defaultTheme" />
		<Parameter id="defaultFont" />
		<Parameter id="getDefUser">Y</Parameter>
		<Parameter id="getBrowser">Chrome</Parameter>
		<Parameter id="_ems_userId" />
		<Parameter id="_ems_organizationId" />
		<Parameter id="_ems_language" />
	</Parameters>
</Root>


