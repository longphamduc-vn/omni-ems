# ==============================================================================
# LG Display EMS (Equipment Management System) API Client Collection
# Sử dụng với VS Code REST Client / IntelliJ HTTP Client / Thunder Client
# ==============================================================================

### Environment Variables
# Local Mock Server (Mặc định khi chạy test nội bộ)
@baseUrl = http://localhost:9000

# Production EMS Server (Bỏ comment để gọi trực tiếp hệ thống EMS thật)
# @baseUrl = http://ems.lgdisplay.com:9000

@contentType = text/xml; charset=UTF-8
@userId = 658359
@orgId = 28753
@lang = EN
@sampleItem = QCAB17587
@sampleItem2 = QDAE01694
@sampleInventoryItemId = 3042180
@engineUrl = http://localhost:8000


# ==============================================================================
# 0. Mock Server Health Check
# ==============================================================================
### Health Check (Kiểm tra trạng thái Mock Server)
GET {{baseUrl}}/api/health
Accept: application/json


# ==============================================================================
# NHÓM 1: 8 API NGHIỆP VỤ LẤY DỮ LIỆU CỐT LÕI (CORE DATA APIS)
# ==============================================================================

### 1. Spare Parts: Tra cứu trạng thái tồn kho phụ tùng (Stock Status)
# Endpoint: RetStockStatusList.lgdn
# Lấy số lượng tồn kho (onhand), phân bổ (allocated), khả dụng (available), đơn giá mới/sửa
POST {{baseUrl}}/emsspareparts/sp101/sp110Nav/RetStockStatusList.lgdn
Content-Type: {{contentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
	<Parameters>
		<Parameter id="_ems_userId">{{userId}}</Parameter>
		<Parameter id="_ems_organizationId">{{orgId}}</Parameter>
		<Parameter id="_ems_language">{{lang}}</Parameter>
	</Parameters>
	<Dataset id="ds_search">
		<ColumnInfo>
			<Column id="organizationId" type="STRING" size="256" />
			<Column id="itemCond" type="STRING" size="256" />
			<Column id="optimizeFlag" type="STRING" size="256" />
		</ColumnInfo>
		<Rows>
			<Row>
				<Col id="organizationId">{{orgId}}</Col>
				<Col id="itemCond">Y</Col>
				<Col id="optimizeFlag">Y</Col>
			</Row>
		</Rows>
	</Dataset>
	<Dataset id="ds_ItemInfo">
		<ColumnInfo>
			<Column id="item" type="STRING" size="256" />
		</ColumnInfo>
		<Rows>
			<Row>
				<Col id="item">{{sampleItem}}</Col>
			</Row>
		</Rows>
	</Dataset>
</Root>


### 2. Spare Parts: Danh sách yêu cầu báo giá linh kiện (RFQ)
# Endpoint: RetEstimateRequestList.lgdn
# Lấy danh sách RFQ báo giá NCC, chi phí ước tính, liên kết Work Order, PR/PO
POST {{baseUrl}}/emsspareparts/sp101/sp120Nav/RetEstimateRequestList.lgdn
Content-Type: {{contentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
	<Parameters>
		<Parameter id="_ems_userId">{{userId}}</Parameter>
		<Parameter id="_ems_organizationId">{{orgId}}</Parameter>
		<Parameter id="_ems_language">{{lang}}</Parameter>
	</Parameters>
	<Dataset id="ds_ItemInfo">
		<ColumnInfo>
			<Column id="item" type="STRING" size="256" />
		</ColumnInfo>
		<Rows>
			<Row>
				<Col id="item">{{sampleItem}}</Col>
			</Row>
		</Rows>
	</Dataset>
</Root>


### 3. Spare Parts: Chi tiết linh kiện & định mức kho (Item Detail Info)
# Endpoint: retrieveItemInfoDetail.lgdn
# Trả về: ds_Item (thông số kỹ thuật), ds_Inv (định mức tối ưu), ds_Summary (thống kê xuất dùng)
POST {{baseUrl}}/emsspareparts/sp102/sp135Nav/retrieveItemInfoDetail.lgdn
Content-Type: {{contentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
	<Parameters>
		<Parameter id="_ems_userId">{{userId}}</Parameter>
		<Parameter id="_ems_organizationId">{{orgId}}</Parameter>
		<Parameter id="_ems_language">{{lang}}</Parameter>
	</Parameters>
	<Dataset id="ds_Input">
		<ColumnInfo>
			<Column id="inventoryItemId" type="STRING" size="256" />
		</ColumnInfo>
		<Rows>
			<Row>
				<Col id="inventoryItemId">{{sampleInventoryItemId}}</Col>
			</Row>
		</Rows>
	</Dataset>
</Root>


### 4. Spare Parts: Tối ưu định mức tồn kho an toàn (Target Stock 93 chỉ số)
# Endpoint: TargetStockSearchList.lgdn
# Lấy 93 chỉ số định mức tồn kho tối ưu, logicQty, safetyQty, lead time, buffer days
POST {{baseUrl}}/emsspareparts/sp302/sp335Nav/TargetStockSearchList.lgdn
Content-Type: {{contentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
	<Parameters>
		<Parameter id="_ems_userId">{{userId}}</Parameter>
		<Parameter id="_ems_organizationId">{{orgId}}</Parameter>
		<Parameter id="_ems_language">{{lang}}</Parameter>
	</Parameters>
	<Dataset id="ds_ItemInfo">
		<ColumnInfo>
			<Column id="item" type="STRING" size="256" />
		</ColumnInfo>
		<Rows>
			<Row>
				<Col id="item">{{sampleItem}}</Col>
			</Row>
		</Rows>
	</Dataset>
</Root>


### 5. Popups: Tra cứu danh mục linh kiện (Popup Item Search)
# Endpoint: retrieveItem.lgdn
# Tìm kiếm linh kiện theo mã Item, mô tả, Maker, Model
POST {{baseUrl}}/emscom/popupNav/retrieveItem.lgdn
Content-Type: {{contentType}}

<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns="http://www.nexacroplatform.com/platform/dataset">
	<Parameters>
		<Parameter id="_ems_userId">{{userId}}</Parameter>
		<Parameter id="_ems_organizationId">{{orgId}}</Parameter>
		<Parameter id="_ems_language">{{lang}}</Parameter>
	</Parameters>
	<Dataset id="ds_Search">
		<ColumnInfo>
			<Column id="item" type="STRING" size="256" />
			<Column id="description" type="STRING" size="256" />
			<Column id="maker" type="STRING" size="256" />
		</ColumnInfo>
		<Rows>
			<Row>
				<Col id="item">QCAD</Col>
				<Col id="description"></Col>
				<Col id="maker"></Col>
			</Row>
		</Rows>
	</Dataset>
</Root>


